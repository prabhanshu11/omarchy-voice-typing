#!/usr/bin/env python3
"""voice-retranscribe — transcribe a saved voice-typing WAV with Deepgram (batch).

Recovery tool from the 2026-09-30 data-loss incident
(docs/issues/2026-09-30-voice-data-loss.md). Every recording is now on disk:
  ~/Programs/recordings/client/<utc>_client.wav   (hyprwhspr, written while recording)
  ~/Programs/recordings/<utc>_audio.wav           (gateway, written before transcribing)
When a transcript did not arrive, run this on the file.

Usage:
  voice-retranscribe FILE.wav [--copy] [--notify] [--json] [--model nova-3]
  voice-retranscribe --pending [--copy] [--notify]   # every failed/crashed client spool
  voice-retranscribe --list                          # client spool files and their status

Writes the transcript next to the audio (client spool: <stem>.txt + status in
<stem>.json; gateway WAV: ~/Programs/transcripts/<ts>_recovered.txt, which is
what orphan-recovery matches). Never deletes or moves audio.

Deepgram key: $DEEPGRAM_API_KEY, else DEEPGRAM_API_KEY in
~/Programs/omarchy-voice-typing/.env, else `pass show api/deepgram`.
Stdlib only: the hyprwhspr daemon (system python) runs it too.
"""

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
REPO = HOME / "Programs" / "omarchy-voice-typing"
RECORDINGS = HOME / "Programs" / "recordings"
SPOOL = RECORDINGS / "client"
TRANSCRIPTS = HOME / "Programs" / "transcripts"
LOG = REPO / "logs" / "retranscribe.log"


def log(msg):
    line = f"[{datetime.now().isoformat(timespec='seconds')}] {msg}"
    print(line, file=sys.stderr)
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with LOG.open("a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def deepgram_key():
    key = os.environ.get("DEEPGRAM_API_KEY", "").strip()
    if key:
        return key
    env = REPO / ".env"
    try:
        for line in env.read_text().splitlines():
            if line.startswith("DEEPGRAM_API_KEY="):
                key = line.split("=", 1)[1].strip().strip('"').strip("'")
                if key:
                    return key
    except OSError:
        pass
    try:
        out = subprocess.run(["pass", "show", "api/deepgram"], capture_output=True,
                             text=True, timeout=10)
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip().splitlines()[0]
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


def transcribe(wav: Path, model: str, timeout: float) -> str:
    key = deepgram_key()
    if not key:
        raise RuntimeError("no Deepgram key (DEEPGRAM_API_KEY / .env / pass api/deepgram)")
    url = (f"https://api.deepgram.com/v1/listen?model={model}"
           "&punctuate=true&smart_format=true")
    req = urllib.request.Request(url, data=wav.read_bytes(), method="POST", headers={
        "Authorization": f"Token {key}", "Content-Type": "audio/wav"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = json.load(resp)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Deepgram HTTP {e.code}: {e.read()[:300]!r}") from None
    alt = body["results"]["channels"][0]["alternatives"][0]
    return (alt.get("transcript") or "").strip()


def meta_path(wav: Path) -> Path:
    return wav.with_suffix(".json")


def read_meta(wav: Path) -> dict:
    try:
        return json.loads(meta_path(wav).read_text())
    except (OSError, ValueError):
        return {}


def write_meta(wav: Path, meta: dict):
    p = meta_path(wav)
    tmp = p.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(meta, indent=2))
    tmp.replace(p)


def save_text(wav: Path, text: str) -> Path:
    if wav.parent.resolve() == RECORDINGS.resolve() and wav.name[:15].replace("_", "").isdigit():
        TRANSCRIPTS.mkdir(parents=True, exist_ok=True)
        out = TRANSCRIPTS / f"{wav.name[:15]}_recovered.txt"
    else:
        out = wav.with_suffix(".txt")
    out.write_text(text)
    if meta_path(wav).exists():
        meta = read_meta(wav)
        meta.update({"status": "recovered", "recovered_at": datetime.now().astimezone().isoformat(timespec="seconds"),
                     "transcript_chars": len(text), "transcript_file": str(out)})
        write_meta(wav, meta)
    return out


def notify(title, body, urgency="normal"):
    try:
        subprocess.Popen(["notify-send", "-a", "Voice typing", "-u", urgency, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def copy(text):
    try:
        subprocess.run(["wl-copy"], input=text, text=True, timeout=5)
        return True
    except (OSError, subprocess.TimeoutExpired):
        return False


def pid_alive(pid) -> bool:
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def pending():
    """Client spool files whose text never arrived: failed, or a crashed recording."""
    out = []
    for wav in sorted(SPOOL.glob("*_client*.wav")):
        meta = read_meta(wav)
        status = meta.get("status", "unknown")
        if status in ("failed", "not-transcribed"):
            out.append(wav)
        elif status == "recording" and not pid_alive(meta.get("pid")):
            out.append(wav)  # hyprwhspr died mid-recording
    return out


def run_one(wav: Path, args) -> str:
    t0 = time.monotonic()
    text = transcribe(wav, args.model, args.timeout)
    out = save_text(wav, text) if text else None
    if not text and meta_path(wav).exists():
        # Deepgram found no words: stop --pending from retrying it forever.
        meta = read_meta(wav)
        meta.update({"status": "retranscribed-empty",
                     "retranscribed_at": datetime.now().astimezone().isoformat(timespec="seconds")})
        write_meta(wav, meta)
    log(f"{wav.name}: {len(text)} chars in {time.monotonic() - t0:.1f}s -> {out}")
    return text


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("wav", nargs="*", type=Path)
    ap.add_argument("--pending", action="store_true", help="retry every failed/crashed client spool file")
    ap.add_argument("--list", action="store_true", help="list client spool files with status")
    ap.add_argument("--copy", action="store_true", help="copy the (last) transcript to the clipboard")
    ap.add_argument("--notify", action="store_true", help="desktop notification with the result")
    ap.add_argument("--json", action="store_true", help="print {file, text} JSON lines")
    ap.add_argument("--model", default="nova-3")
    ap.add_argument("--timeout", type=float, default=60.0)
    args = ap.parse_args()

    if args.list:
        for wav in sorted(SPOOL.glob("*_client*.wav")):
            m = read_meta(wav)
            print(f"{wav.name}\t{m.get('status', '?')}\t{m.get('duration_s', '?')}s\t"
                  f"{m.get('started_local', '')}\t{m.get('error', '')}")
        return 0

    files = list(args.wav) + (pending() if args.pending else [])
    if not files:
        if args.pending:
            return 0
        ap.error("give a WAV file, --pending or --list")

    rc, last = 0, ""
    for wav in files:
        try:
            text = run_one(wav, args)
        except Exception as e:  # keep going: one bad file must not block the rest
            log(f"{wav}: FAILED {e}")
            if meta_path(wav).exists():
                meta = read_meta(wav)
                meta["retranscribe_error"] = str(e)[:300]
                write_meta(wav, meta)
            if args.notify:
                notify("Voice typing: re-transcription failed",
                       f"{e}\nAudio is safe: file://{wav}\nRetry: voice-retranscribe {wav}", "critical")
            rc = 1
            continue
        if args.json:
            print(json.dumps({"file": str(wav), "text": text}), flush=True)
        else:
            print(text, flush=True)
        if text:
            last = text
            if args.notify:
                notify("Voice typing: recovered transcript",
                       (text[:180] + ("…" if len(text) > 180 else ""))
                       + ("\n(copied to clipboard)" if args.copy else "") + f"\nfile://{wav}")
    if args.copy and last:
        copy(last)
    return rc


if __name__ == "__main__":
    sys.exit(main())
